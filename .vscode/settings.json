{
  "go.goroot": "~/.local/go",
  "go.gopath": "~/go",
  "go.toolsEnvVars": {
    "PATH": "${env:HOME}/.local/go/bin:${env:HOME}/go/bin:${env:PATH}"
  },
  "terminal.integrated.env.linux": {
    "PATH": "${env:HOME}/.local/go/bin:${env:HOME}/go/bin:${env:PATH}"
  },
  "[go]": {
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": { "source.organizeImports": "explicit" }
  }
}
